<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UMPay Mobile QA Suite" verbose="1">

    <!-- No listeners.

         The report and its email are built from Cucumber's own hooks, in MobileBaseClass
         and MobileReport, because cucumber-testng drives every scenario through a single
         runScenario method - a TestNG listener would see one test where eight ran. -->

    <test name="UMPay Mobile Flows">
        <classes>
            <!-- The Cucumber runner. Which scenarios it picks up is decided by the tags in
                 its @CucumberOptions, currently everything except @register. -->
            <class name="com.umpay.mobile.runner.MobileTestRunner"/>
        </classes>
    </test>

</suite>
