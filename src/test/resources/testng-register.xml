<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UMPay Register Flow" verbose="1">

    <!-- Just the sign-up path.

         @register is held out of the ordinary suite because it creates a real account on
         the test environment and needs a captcha solved, so it is run deliberately rather
         than nightly. The tag is passed as a suite parameter: cucumber-testng reads the
         XML test's parameters as Cucumber properties, so this is the file-based equivalent
         of -Dcucumber.filter.tags="@register". -->

    <test name="Register only">
        <parameter name="cucumber.filter.tags" value="@register"/>
        <classes>
            <class name="com.umpay.mobile.runner.MobileTestRunner"/>
        </classes>
    </test>

</suite>
